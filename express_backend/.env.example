# Express backend configuration
PORT=3001

# MongoDB connection
# Defaults to local mongodb running at localhost:5001 with user appuser/dbuser123 and db 'myapp'
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5001/myapp?authSource=admin
MONGODB_DB=myapp

# JWT secret for signing auth tokens
JWT_SECRET=change_me_in_production

# Example environment configuration for Express backend

# MongoDB connection string, e.g. mongodb://localhost:27017/gourmet
MONGODB_URI=mongodb://localhost:27017/gourmet

# Secret for signing JWTs (change in production)
JWT_SECRET=change_me_dev_secret

# Server port
PORT=3001

# CORS origin for local React frontend
CORS_ORIGIN=http://localhost:3000
